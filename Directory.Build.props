<Project>
  <!-- Optional per-machine overrides (git-ignored). See VikingsForHire.user.props.example. -->
  <Import Project="$(MSBuildThisFileDirectory)VikingsForHire.user.props" Condition="Exists('$(MSBuildThisFileDirectory)VikingsForHire.user.props')" />

  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">/games/SteamLibrary/steamapps/common/Valheim</ValheimDir>
    <GaleProfileDir Condition="'$(GaleProfileDir)' == ''">$(HOME)/.local/share/com.kesomannen.gale/valheim/profiles/vikingsforhire-dev</GaleProfileDir>

    <ManagedDir>$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <BepInExCoreDir>$(GaleProfileDir)/BepInEx/core</BepInExCoreDir>
    <PluginsDir>$(GaleProfileDir)/BepInEx/plugins</PluginsDir>
  </PropertyGroup>
</Project>
