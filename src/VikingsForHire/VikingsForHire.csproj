<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>HiredHands</AssemblyName>
    <RootNamespace>VikingsForHire</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <!-- Keep in sync with package/manifest.json and Plugin.Version; the Package target checks all three. -->
    <Version>0.4.3</Version>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <!-- build assets excluded: JotunnLib's props inject ~80 Valheim references that clash with ours. -->
    <PackageReference Include="JotunnLib" Version="2.30.1" ExcludeAssets="runtime;build" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" LogicalName="VikingsForHire.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- AzuAutoStore, AzuCraftyBoxes and PullMats are soft dependencies reached by reflection only; never reference them here. -->
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)/0Harmony.dll" Private="false" />

    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" Private="false" />
    <Reference Include="Splatform" HintPath="$(ManagedDir)/Splatform.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)/assembly_guiutils.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(ManagedDir)/UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDir)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />

    <Reference Include="YamlDotNet" HintPath="$(PluginsDir)/ValheimModding-YamlDotNet/YamlDotNet.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the built plugin and the test macro aliases into the Gale dev profile. -->
  <Target Name="DeployToGale" AfterTargets="Build" Condition="Exists('$(PluginsDir)')">
    <ItemGroup>
      <DeployFiles Include="$(TargetPath)" />
      <DeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginsDir)/Spronglehump-HiredHands" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(RepoRoot)test/alias_vfh.yaml" DestinationFolder="$(GaleProfileDir)/BepInEx/config" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="HiredHands deployed to $(PluginsDir)/Spronglehump-HiredHands (+ alias_vfh.yaml)" />
  </Target>

  <!-- Thunderstore/Hexium zip: dotnet build -c Release -t:Package -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RepoRoot)package/manifest.json')), '"version_number"\s*:\s*"([^"]+)"').Groups[1].Value)</ManifestVersion>
      <PluginVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Plugin.cs')), 'Version\s*=\s*"([^"]+)"').Groups[1].Value)</PluginVersion>
      <PackageStage>$(MSBuildThisFileDirectory)obj/package/</PackageStage>
      <PackageZip>$(RepoRoot)dist/Spronglehump-HiredHands-$(Version).zip</PackageZip>
    </PropertyGroup>
    <Error Condition="'$(ManifestVersion)' != '$(Version)' Or '$(PluginVersion)' != '$(Version)'"
           Text="Version mismatch: csproj $(Version), manifest.json $(ManifestVersion), Plugin.Version $(PluginVersion)" />

    <RemoveDir Directories="$(PackageStage)" />
    <Copy SourceFiles="$(RepoRoot)package/manifest.json;$(RepoRoot)package/icon.png;$(RepoRoot)README.md;$(RepoRoot)CHANGELOG.md"
          DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStage)plugins" />
    <MakeDir Directories="$(RepoRoot)dist" />
    <ZipDirectory SourceDirectory="$(PackageStage)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(PackageZip)" />
  </Target>

</Project>
